generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PassStatus {
  UNCLAIMED
  ACTIVE
  EXHAUSTED
  EXPIRED
  BLOCKED
  CANCELLED
}

enum PassUnitType {
  ITEM
  MONEY
}

enum PassTransactionType {
  PURCHASE
  CLAIM
  REDEEM
  REFUND
  ADJUSTMENT
  REVERSAL
}

model Client {
  id                        Int                  @id @default(autoincrement())
  name                      String
  phone                     String               @unique
  email                     String?              @unique
  instagramHandle           String?
  instagramFollowConfirmed  Boolean              @default(false)
  uniqueToken               String               @unique
  isActive                  Boolean              @default(true)
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  loyaltyStatus             LoyaltyStatus?
  loyaltyTransactions       LoyaltyTransaction[]
  clientViews               ClientView[]
  passes                    Pass[]
}

// Legacy loyalty models kept temporarily so the original Pasta Lovers flow
// continues working while Modo Cafe Pass is tested in parallel.
model LoyaltyStatus {
  id              Int       @id @default(autoincrement())
  clientId        Int       @unique
  currentChecks   Int       @default(0)
  rewardAvailable Boolean   @default(false)
  cycleNumber     Int       @default(1)
  lastCheckinAt   DateTime?
  lastRedeemedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model LoyaltyTransaction {
  id               Int        @id @default(autoincrement())
  clientId         Int
  type             String
  checksDelta      Int        @default(0)
  notes            String?
  createdByUserId  Int?
  createdAt        DateTime   @default(now())

  client           Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdByUser    StaffUser? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
}

model PassProduct {
  id              Int          @id @default(autoincrement())
  name            String
  description     String?
  unitType        PassUnitType @default(ITEM)
  initialUnits    Int?
  initialAmount   Int?
  salePrice       Int
  currency        String       @default("PYG")
  validityDays    Int?
  isGift          Boolean      @default(false)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  passes          Pass[]

  @@index([isActive])
  @@index([isGift, isActive])
}

model Pass {
  id              Int          @id @default(autoincrement())
  publicId        String       @unique
  clientId        Int?
  productId       Int
  status          PassStatus   @default(ACTIVE)
  unitType        PassUnitType
  initialUnits    Int?
  remainingUnits  Int?
  initialAmount   Int?
  remainingAmount Int?
  purchasedAt     DateTime     @default(now())
  expiresAt       DateTime?
  blockedAt       DateTime?
  cancelledAt     DateTime?
  claimTokenHash  String?      @unique
  claimExpiresAt  DateTime?
  claimedAt       DateTime?
  purchaserName   String?
  purchaserPhone  String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  client          Client?      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  product         PassProduct  @relation(fields: [productId], references: [id], onDelete: Restrict)
  transactions    PassTransaction[]

  @@index([clientId, status])
  @@index([productId, status])
  @@index([expiresAt])
  @@index([claimExpiresAt])
}

model PassTransaction {
  id                 Int                 @id @default(autoincrement())
  passId             Int
  type               PassTransactionType
  unitsDelta         Int?
  amountDelta        Int?
  balanceUnitsAfter  Int?
  balanceAmountAfter Int?
  idempotencyKey     String              @unique
  notes              String?
  createdByUserId    Int?
  reversedById       Int?                @unique
  createdAt          DateTime            @default(now())

  pass               Pass                @relation(fields: [passId], references: [id], onDelete: Restrict)
  createdByUser      StaffUser?          @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  reversalOf         PassTransaction?    @relation("TransactionReversal", fields: [reversedById], references: [id])
  reversedBy         PassTransaction?    @relation("TransactionReversal")

  @@index([passId, createdAt])
  @@index([createdByUserId, createdAt])
}

model StaffUser {
  id                  Int                  @id @default(autoincrement())
  name                String
  email               String               @unique
  passwordHash        String
  role                String               @default("staff")
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  loyaltyTransactions LoyaltyTransaction[]
  passTransactions    PassTransaction[]
  promotions          Promotion[]
}

model Promotion {
  id               Int        @id @default(autoincrement())
  title            String
  description      String?
  imageUrl         String?
  buttonText       String?
  buttonLink       String?
  startAt          DateTime?
  endAt            DateTime?
  priority         Int        @default(0)
  isActive         Boolean    @default(true)
  createdByUserId  Int?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  createdByUser    StaffUser? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
}

model ClientView {
  id         Int      @id @default(autoincrement())
  clientId   Int
  source     String?
  viewedAt   DateTime @default(now())

  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}